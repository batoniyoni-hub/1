# Flask Configuration
FLASK_DEBUG=False
FLASK_ENV=production

# Facebook API Keys
FACEBOOK_API_KEY=your_api_key_here
FACEBOOK_API_SECRET=your_api_secret_here
FACEBOOK_APP_ID=your_app_id_here
FACEBOOK_APP_SECRET=your_app_secret_here

# Database
DATABASE_PATH=accounts.db
PROXY_DATABASE_PATH=proxies.db

# Proxy Configuration
PROXY_TIMEOUT=5
MAX_PROXY_WORKERS=50
PROXY_CHECK_INTERVAL=3600

# Account Configuration
MAX_THREADS=10
ACCOUNT_TIMEOUT=300
RETRY_ATTEMPTS=3
MIN_AGE=18
MAX_AGE=45
DEFAULT_COUNTRY=US

# Mail Configuration
MAIL_PROVIDERS=mail.tm,1secmail.com
MAIL_TIMEOUT=10

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
